{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(icon-192\\.png|icon-512\\.png|icon\\.svg|favicon\\.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexxchat-5d29.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://nexxchat-5d29.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/|assets/|robots\\.txt|sitemap\\.xml|manifest\\.json|sw\\.js|app-ads\\.txt|google[a-z0-9]+\\.html|.*\\.(?:png|jpg|jpeg|svg|ico|webp|js|css|json|xml|txt|apk|exe)).*)",
      "destination": "/index.html"
    }
  ]
}
